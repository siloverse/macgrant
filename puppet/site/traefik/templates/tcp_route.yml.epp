<%- |
  String $route_name,
  String $entry_point,
  String $target,
  String $rule,
  Boolean $tls_passthrough,
| -%>
tcp:
  routers:
    <%= $route_name %>:
      entryPoints:
        - <%= $entry_point %>
      rule: "<%= $rule %>"
      service: <%= $route_name %>
<% if $tls_passthrough { -%>
      tls:
        passthrough: true
<% } -%>

  services:
    <%= $route_name %>:
      loadBalancer:
        servers:
          - address: "<%= $target %>"
