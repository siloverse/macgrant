<%- |
  String $dynamic_config_dir,
  String $private_ip,
  Hash[String, Integer] $tcp_entry_points,
| -%>
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"
<% $tcp_entry_points.each |String $name, Integer $port| { -%>

  <%= $name %>:
    address: "<%= $private_ip %>:<%= $port %>"
<% } -%>

providers:
  file:
    directory: "<%= $dynamic_config_dir %>"
    watch: true

log:
  level: INFO

accessLog: {}
