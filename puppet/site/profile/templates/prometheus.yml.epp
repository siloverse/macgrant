<%- |
  String $listen_address,
  Integer $port,
  String $scrape_interval,
  String $evaluation_interval,
  String $retention_time,
  String $retention_size,
  String $node_exporter_address,
  Integer $node_exporter_port,
  String $collector_metrics_address,
  Integer $collector_metrics_port,
  String $tempo_metrics_address,
  Integer $tempo_metrics_port,
  String $loki_metrics_address,
  Integer $loki_metrics_port,
  String $grafana_metrics_address,
  Integer $grafana_metrics_port,
| -%>
global:
  scrape_interval: <%= $scrape_interval %>
  scrape_timeout: 10s
  evaluation_interval: <%= $evaluation_interval %>

  external_labels:
    platform: macgrant
    environment: local

storage:
  tsdb:
    retention:
      time: <%= $retention_time %>
      size: <%= $retention_size %>

scrape_configs:
  - job_name: prometheus

    static_configs:
      - targets:
          - "<%= $listen_address %>:<%= $port %>"

        labels:
          component: prometheus

  - job_name: node-exporter

    static_configs:
      - targets:
          - "<%= $node_exporter_address %>:<%= $node_exporter_port %>"

        labels:
          component: node-exporter
          node: macgrant-platform

  - job_name: opentelemetry-collector

    static_configs:
      - targets:
          - "<%= $collector_metrics_address %>:<%= $collector_metrics_port %>"

        labels:
          component: opentelemetry-collector

  - job_name: tempo

    static_configs:
      - targets:
          - "<%= $tempo_metrics_address %>:<%= $tempo_metrics_port %>"

        labels:
          component: tempo

  - job_name: grafana

    static_configs:
      - targets:
          - "<%= $grafana_metrics_address %>:<%= $grafana_metrics_port %>"

        labels:
          component: grafana

  - job_name: loki

    static_configs:
      - targets:
          - "<%= $loki_metrics_address %>:<%= $loki_metrics_port %>"

        labels:
          component: loki
