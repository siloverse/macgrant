<%- |
  String $hostname,
  String $listen_address,
  Integer $port,
  String $config_file,
  String $data_dir,
  String $install_dir
| -%>
[Unit]
Description=Prometheus monitoring and time-series database
Documentation=https://prometheus.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=prometheus
Group=prometheus

ExecStart=/usr/local/bin/prometheus \
  --config.file=<%= $config_file %> \
  --storage.tsdb.path=<%= $data_dir %> \
  --web.listen-address=<%= $listen_address %>:<%= $port %> \
  --web.external-url=https://<%= $hostname %> \
  --web.console.templates=<%= $install_dir %>/consoles \
  --web.console.libraries=<%= $install_dir %>/console_libraries

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

TimeoutStopSec=20s
KillSignal=SIGTERM

LimitNOFILE=65536
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target