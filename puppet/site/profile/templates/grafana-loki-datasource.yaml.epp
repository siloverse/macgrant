<%- |
  String $loki_url
| -%>
apiVersion: 1

datasources:
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: <%= $loki_url %>
    basicAuth: false
    isDefault: false
    editable: false

    jsonData:
      timeout: 60
      maxLines: 1000

      # log line -> its trace: trace_id arrives as OTLP structured metadata (a field, not line text)
      derivedFields:
        - name: TraceID
          matcherType: label
          matcherRegex: trace_id
          url: '$${__value.raw}'
          datasourceUid: tempo
          urlDisplayLabel: 'View trace'
